# WhatsApp contact (digits only, with country code, no + or spaces)
# Example India: 916380243702
# Set this in the Vercel project → Settings → Environment Variables
WA_PRIYAN=

# Optional: override the live-board publish key (defaults to the admin password)
# ADMIN_SYNC_SECRET=

# Free live board (so every phone sees the same fixtures) — NO Vercel paid Storage needed
# 1. Sign up free at https://console.upstash.com
# 2. Create → Redis Database → Free tier
# 3. Open the database → REST API → copy URL + TOKEN
# 4. Paste both into Vercel → Settings → Environment Variables → Redeploy
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
